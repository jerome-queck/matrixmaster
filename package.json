{
  "name": "matrix-master",
  "private": true,
  "version": "1.3.0",
  "description": "Offline-first linear algebra workspace for numeric and symbolic computation.",
  "author": "Matrix Master",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "test": "npm run test:calc && npm run test:ui",
    "verify": "bash scripts/verify.sh",
    "verify:desktop": "bash scripts/verify-desktop.sh",
    "verify:full": "bash scripts/verify-full.sh",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:3000 && ELECTRON_DEV=1 electron -r ts-node/register/transpile-only electron/main.ts\"",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json",
    "electron:dist": "npm run electron:build && electron-builder",
    "release:check": "node -e \"const p=require('./package.json'); if(!p.version||p.version==='0.0.0'){console.error('Set package.json version before release.'); process.exit(1)}\" && npm run build && npm run test && npm run electron:dist && node scripts/check-release-artifacts.js",
    "test:calc": "node -r ts-node/register tests/calculation.test.ts",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "katex": "^0.16.22",
    "lz-string": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.7",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.3",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "overrides": {
    "jiti": "^2.4.2"
  },
  "main": "electron-dist/main.js",
  "build": {
    "appId": "com.matrixmaster.app",
    "productName": "Matrix Master",
    "files": [
      "dist/index.html",
      "dist/assets/**",
      "electron-dist/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "sign": false,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
