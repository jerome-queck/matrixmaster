{
  "name": "matrix-master:-the-comprehensive-linear-algebra-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --loader ts-node/esm tests/calculation.test.ts",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:3000 && ELECTRON_DEV=1 electron -r ts-node/register/transpile-only electron/main.ts\"",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json",
    "electron:dist": "npm run electron:build && electron-builder"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "lz-string": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^34.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^7.2.0"
  },
  "main": "electron-dist/main.js",
  "build": {
    "appId": "com.matrixmaster.app",
    "productName": "Matrix Master",
    "files": [
      "dist/**",
      "electron-dist/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
